* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #f4f6f8;
  color: #1f2937;
}

button,
input {
  font-family: inherit;
}

button {
  cursor: pointer;
  border: none;
}

.app {
  min-height: 100vh;
  padding: 50px 20px;
}

.todo-container {
  width: 100%;
  max-width: 800px;
  margin: 0 auto;
}

/* Header */

.header {
  text-align: center;
  margin-bottom: 30px;
}

.header h1 {
  font-size: 38px;
  margin-bottom: 8px;
  color: #111827;
}

.header p {
  color: #6b7280;
  font-size: 16px;
}

/* Form */

.todo-form {
  display: flex;
  gap: 12px;
  margin-bottom: 25px;
}

.todo-form input {
  flex: 1;
  height: 52px;
  padding: 0 17px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  outline: none;
  background: white;
  font-size: 16px;
  transition: 0.2s;
}

.todo-form input:focus {
  border-color: #4f46e5;
  box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
}

.todo-form button {
  padding: 0 25px;
  border-radius: 10px;
  background: #4f46e5;
  color: white;
  font-size: 15px;
  font-weight: 600;
  transition: 0.2s;
}

.todo-form button:hover {
  background: #4338ca;
}

/* Content */

.todo-content {
  background: white;
  border-radius: 14px;
  box-shadow: 0 5px 25px rgba(0, 0, 0, 0.07);
  overflow: hidden;
}

/* Top Bar */

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  border-bottom: 1px solid #e5e7eb;
}

.filters {
  display: flex;
  gap: 6px;
}

.filters button {
  padding: 8px 14px;
  border-radius: 7px;
  background: transparent;
  color: #6b7280;
  font-size: 14px;
  transition: 0.2s;
}

.filters button:hover {
  background: #f3f4f6;
}

.filters button.active {
  background: #4f46e5;
  color: white;
}

.clear-btn {
  background: transparent;
  color: #ef4444;
  font-size: 14px;
}

.clear-btn:hover {
  text-decoration: underline;
}

/* Todo List */

.todo-list {
  min-height: 150px;
}

.todo-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 17px 20px;
  border-bottom: 1px solid #eef0f2;
  transition: 0.2s;
}

.todo-item:hover {
  background: #fafafa;
}

.todo-item:last-child {
  border-bottom: none;
}

/* Check Button */

.check-btn {
  width: 23px;
  height: 23px;
  flex-shrink: 0;
  border: 2px solid #cbd5e1;
  border-radius: 50%;
  background: white;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: bold;
  transition: 0.2s;
}

.check-btn:hover {
  border-color: #4f46e5;
}

.completed .check-btn {
  background: #4f46e5;
  border-color: #4f46e5;
}

/* Todo Text */

.todo-text {
  flex: 1;
  font-size: 16px;
  color: #374151;
  word-break: break-word;
}

.completed .todo-text {
  color: #9ca3af;
  text-decoration: line-through;
}

/* Edit Input */

.edit-input {
  flex: 1;
  min-width: 0;
  height: 38px;
  padding: 0 10px;
  border: 1px solid #4f46e5;
  border-radius: 6px;
  outline: none;
  font-size: 16px;
}

/* Actions */

.actions {
  display: flex;
  gap: 7px;
  flex-shrink: 0;
}

.actions button {
  padding: 7px 10px;
  border-radius: 6px;
  font-size: 13px;
}

.edit-btn {
  background: #eef2ff;
  color: #4f46e5;
}

.edit-btn:hover {
  background: #e0e7ff;
}

.delete-btn {
  background: #fef2f2;
  color: #ef4444;
}

.delete-btn:hover {
  background: #fee2e2;
}

.save-btn {
  background: #ecfdf5;
  color: #059669;
}

.save-btn:hover {
  background: #d1fae5;
}

.cancel-btn {
  background: #f3f4f6;
  color: #4b5563;
}

.cancel-btn:hover {
  background: #e5e7eb;
}

/* Empty */

.empty {
  text-align: center;
  padding: 55px 20px;
}

.empty-icon {
  width: 55px;
  height: 55px;
  margin: 0 auto 15px;
  border-radius: 50%;
  background: #eef2ff;
  color: #4f46e5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25px;
}

.empty h3 {
  margin-bottom: 7px;
  color: #374151;
}

.empty p {
  color: #9ca3af;
  font-size: 14px;
}

/* Footer */

.footer {
  display: flex;
  justify-content: space-between;
  padding: 15px 20px;
  background: #fafafa;
  border-top: 1px solid #e5e7eb;
  color: #6b7280;
  font-size: 13px;
}

/* Responsive */

@media (max-width: 600px) {
  .app {
    padding: 30px 14px;
  }

  .header h1 {
    font-size: 30px;
  }

  .todo-form {
    flex-direction: column;
  }

  .todo-form input {
    width: 100%;
  }

  .todo-form button {
    height: 50px;
  }

  .top-bar {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .filters {
    justify-content: center;
  }

  .clear-btn {
    text-align: center;
  }

  .todo-item {
    align-items: flex-start;
  }

  .actions {
    flex-direction: column;
  }

  .actions button {
    padding: 6px 8px;
  }

  .footer {
    font-size: 12px;
  }
}


