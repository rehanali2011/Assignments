import { useState } from "react";
import Counter from "./components/Counter";
import Profile from "./components/Profile";
import ThemeBox from "./components/ThemeBox";
import Todo from "./components/Todo";

import "./App.css";

function App() {
  // STATE MANAGEMENT
  const [studentName, setStudentName] = useState("Student");

  const [score, setScore] = useState(0);

  const changeStudentName = () => {
    setStudentName("React Student");
  };

  const increaseScore = () => {
    setScore(score + 1);
  };

  return (
    <div className="app">

      <header className="header">
        <h1>React State Practice</h1>

        <p>
          Learning State, Events and Re-rendering
        </p>
      </header>

      <main className="container">

        {/* STATE */}
        <section className="box">
          <h2>1. What is State?</h2>

          <p>
            State is data that can change inside a React component.
          </p>

          <div className="result">
            Student Name: <strong>{studentName}</strong>
          </div>

          <button onClick={changeStudentName}>
            Change Name
          </button>
        </section>

        {/* STATE MANAGEMENT */}
        <section className="box">
          <h2>2. State Management</h2>

          <p>
            State management means controlling and updating
            data used by components.
          </p>

          <div className="score">
            Score: {score}
          </div>

          <button onClick={increaseScore}>
            Increase Score
          </button>
        </section>

        {/* COMPONENT STATE */}
        <section className="box">
          <h2>3. Component State</h2>

          <Counter />
        </section>

        {/* EVENTS */}
        <section className="box">
          <h2>4. Event Handling</h2>

          <Profile />
        </section>

        {/* RE-RENDER */}
        <section className="box">
          <h2>5. When Does Component Re-render?</h2>

          <ThemeBox />
        </section>

        {/* PRACTICE */}
        <section className="box">
          <h2>6. State Management Practice</h2>

          <Todo />
        </section>

      </main>

    </div>
  );
}

export default App;

Counter.jsx

import { useState } from "react";

function Counter() {
  const [count, setCount] = useState(0);

  const increase = () => {
    setCount(count + 1);
  };

  const decrease = () => {
    setCount(count - 1);
  };

  const reset = () => {
    setCount(0);
  };

  return (
    <div className="component-box">

      <h3>Counter Component</h3>

      <div className="counter-number">
        {count}
      </div>

      <div className="button-group">

        <button onClick={decrease}>
          −
        </button>

        <button onClick={reset}>
          Reset
        </button>

        <button onClick={increase}>
          +
        </button>

      </div>

      <p>
        Every time the state changes, this component
        renders again with the new value.
      </p>

    </div>
  );
}

export default Counter;

