});

src/12-practice.ts

interface StudentRecord {
  id: number;
  name: string;
  marks: number;
  course: string;
}

const students: StudentRecord[] = [
  {
    id: 1,
    name: "Ali",
    marks: 85,
    course: "TypeScript"
  },
  {
    id: 2,
    name: "Sara",
    marks: 92,
    course: "React"
  },
  {
    id: 3,
    name: "Ahmed",
    marks: 45,
    course: "JavaScript"
  },
  {
    id: 4,
    name: "Ayesha",
    marks: 76,
    course: "TypeScript"
  }
];

function displayStudents(list: StudentRecord[]): void {
  list.forEach((student) => {
    console.log(
      `${student.name} - ${student.course} - Marks: ${student.marks}`
    );
  });
}

function findStudent(id: number): StudentRecord | undefined {
  return students.find((student) => student.id === id);
}

function getPassedStudents(): StudentRecord[] {
  return students.filter((student) => student.marks >= 50);
}

function calculateAverage(): number {
  const total = students.reduce(
    (sum, student) => sum + student.marks,
    0
  );

  return total / students.length;
}

console.log("All Students:");
displayStudents(students);

console.log("Student with ID 2:");
console.log(findStudent(2));

console.log("Passed Students:");
displayStudents(getPassedStudents());

console.log("Average Marks:", calculateAverage());



