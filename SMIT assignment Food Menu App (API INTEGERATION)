====> JAVA SCRIPT

const API_URL = "https://dummyjson.com/recipes";

const foodContainer = document.getElementById("foodContainer");
const loader = document.getElementById("loader");
const errorMessage = document.getElementById("errorMessage");
const resultText = document.getElementById("resultText");

const searchInput = document.getElementById("searchInput");
const searchBtn = document.getElementById("searchBtn");

const modal = document.getElementById("foodModal");
const closeModal = document.getElementById("closeModal");

const modalImage = document.getElementById("modalImage");
const modalTitle = document.getElementById("modalTitle");
const modalRating = document.getElementById("modalRating");
const modalCuisine = document.getElementById("modalCuisine");
const modalDifficulty = document.getElementById("modalDifficulty");
const modalDescription = document.getElementById("modalDescription");

const modalIngredients = document.getElementById("modalIngredients");

const modalPrep = document.getElementById("modalPrep");
const modalCook = document.getElementById("modalCook");
const modalServings = document.getElementById("modalServings");
const modalCalories = document.getElementById("modalCalories");


// =====================================
// Get All Recipes
// =====================================

async function getRecipes() {

    showLoader();

    try {

        const response = await fetch(`${API_URL}?limit=0`);

        if (!response.ok) {
            throw new Error("Failed to fetch recipes");
        }

        const data = await response.json();

        displayRecipes(data.recipes);

    } catch (error) {

        console.error(error);

        showError(
            "Unable to load food menu. Please try again."
        );

    } finally {

        hideLoader();

    }
}


// =====================================
// Search Recipes
// =====================================

async function searchRecipes() {

    const searchValue = searchInput.value.trim();

    if (searchValue === "") {

        getRecipes();

        return;
    }

    showLoader();

    try {

        const response = await fetch(
            `${API_URL}/search?q=${encodeURIComponent(searchValue)}`
        );

        if (!response.ok) {
            throw new Error("Search failed");
        }

        const data = await response.json();

        displayRecipes(data.recipes);

    } catch (error) {

        console.error(error);

        showError(
            "Something went wrong while searching."
        );

    } finally {

        hideLoader();

    }
}


// =====================================
// Display Recipes
// =====================================

function displayRecipes(recipes) {

    foodContainer.innerHTML = "";
    errorMessage.textContent = "";

    if (!recipes || recipes.length === 0) {

        resultText.textContent = "No food found.";

        foodContainer.innerHTML = `
            <div style="
                grid-column: 1 / -1;
                text-align: center;
                padding: 40px;
                color: #777;
            ">
                <h3>No recipes found 😕</h3>
                <p>Try searching for another food.</p>
            </div>
        `;

        return;
    }

    resultText.textContent =
        `${recipes.length} delicious recipes found`;

    recipes.forEach(recipe => {

        const card = document.createElement("div");

        card.className = "food-card";

        card.innerHTML = `

            <img
                class="food-image"
                src="${recipe.image}"
                alt="${recipe.name}"
            >

            <div class="food-body">

                <h3>${recipe.name}</h3>

                <p class="food-description">
                    ${createDescription(recipe)}
                </p>

                <div class="food-info">

                    <span class="info-tag rating">
                        ⭐ ${recipe.rating}
                    </span>

                    <span class="info-tag">
                        🌍 ${recipe.cuisine}
                    </span>

                    <span class="info-tag">
                        ⏱️ ${recipe.cookTimeMinutes} min
                    </span>

                    <span class="info-tag">
                        ${recipe.difficulty}
                    </span>

                </div>

                <button
                    class="details-btn"
                    onclick="openRecipe(${recipe.id})"
                >
                    View Details
                </button>

            </div>
        `;

        foodContainer.appendChild(card);

    });
}


// =====================================
// Create Description
// =====================================

function createDescription(recipe) {

    if (
        recipe.ingredients &&
        recipe.ingredients.length > 0
    ) {

        return `
            Delicious ${recipe.cuisine} recipe made with
            ${recipe.ingredients.slice(0, 3).join(", ")} and more.
        `;

    }

    return "A delicious recipe you can explore.";
}


// =====================================
// Open Recipe Details
// =====================================

async function openRecipe(id) {

    try {

        const response = await fetch(
            `${API_URL}/${id}`
        );

        if (!response.ok) {
            throw new Error("Recipe not found");
        }

        const recipe = await response.json();

        // Image
        modalImage.src = recipe.image;
        modalImage.alt = recipe.name;

        // Title
        modalTitle.textContent = recipe.name;

        // Rating
        modalRating.textContent =
            `⭐ ${recipe.rating} (${recipe.reviewCount} reviews)`;

        // Cuisine
        modalCuisine.textContent =
            `🌍 ${recipe.cuisine}`;

        // Difficulty
        modalDifficulty.textContent =
            `📊 ${recipe.difficulty}`;

        // Description
        const meals = Array.isArray(recipe.mealType)
            ? recipe.mealType.join(", ")
            : "different meals";

        modalDescription.textContent =
            `Enjoy this delicious ${recipe.cuisine} recipe. ` +
            `It is perfect for ${meals}.`;

        // Preparation
        modalPrep.textContent =
            `${recipe.prepTimeMinutes} minutes`;

        // Cooking
        modalCook.textContent =
            `${recipe.cookTimeMinutes} minutes`;

        // Servings
        modalServings.textContent =
            `${recipe.servings}`;

        // Calories
        modalCalories.textContent =
            `${recipe.caloriesPerServing} kcal`;

        // Ingredients
        modalIngredients.innerHTML = "";

        recipe.ingredients.forEach(ingredient => {

            const li = document.createElement("li");

            li.textContent = ingredient;

            modalIngredients.appendChild(li);

        });

        // Open modal
        modal.classList.add("active");

        document.body.style.overflow = "hidden";

    } catch (error) {

        console.error(error);

        alert("Unable to load recipe details.");

    }
}


// =====================================
// Close Modal
// =====================================

function closeRecipeModal() {

    modal.classList.remove("active");

    document.body.style.overflow = "auto";
}

closeModal.addEventListener(
    "click",
    closeRecipeModal
);


// =====================================
// Close Modal By Clicking Outside
// =====================================

modal.addEventListener("click", function (event) {

    if (event.target === modal) {

        closeRecipeModal();

    }

});


// =====================================
// Search Button
// =====================================

searchBtn.addEventListener(
    "click",
    searchRecipes
);


// =====================================
// Search With Enter Key
// =====================================

searchInput.addEventListener(
    "keydown",
    function (event) {

        if (event.key === "Enter") {

            searchRecipes();

        }

    }
);


// =====================================
// Loader
// =====================================

function showLoader() {

    loader.style.display = "block";

    foodContainer.innerHTML = "";

    errorMessage.textContent = "";

    resultText.textContent =
        "Loading delicious food...";
}


function hideLoader() {

    loader.style.display = "none";

}


// =====================================
// Error
// =====================================

function showError(message) {

    loader.style.display = "none";

    foodContainer.innerHTML = "";

    errorMessage.textContent = message;

    resultText.textContent =
        "Something went wrong.";

}


// =====================================
// Start Application
// =====================================

getRecipes();
