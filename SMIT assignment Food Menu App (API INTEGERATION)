<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Menu</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header class="header">
        <div class="container nav">

            <div class="logo">
                <span>Food Menu</span> 
            </div>

            <div class="search-box">
                <input
                    type="text"
                    id="searchInput"
                    placeholder="Search food..."
                >
                <button id="searchBtn">Search</button>
            </div>

        </div>
    </header>

    <!-- Hero -->
    <section class="hero">
        <div class="container">
            <h1>Delicious Food Menu</h1>
            <p>Explore delicious recipes from different cuisines</p>
        </div>
    </section>

    <!-- Menu -->
    <main class="container menu-section">

        <div class="section-heading">
            <h2>Our Menu</h2>
            <p id="resultText">Loading delicious food...</p>
        </div>

        <!-- Loading -->
        <div id="loader" class="loader">
            <div class="spinner"></div>
            <p>Loading food...</p>
        </div>

        <!-- Error -->
        <div id="errorMessage" class="error-message"></div>

        <!-- Food Cards -->
        <div id="foodContainer" class="food-grid"></div>

    </main>

    <!-- Modal -->
    <div id="foodModal" class="modal">

        <div class="modal-content">

            <button id="closeModal" class="close-btn">
                ×
            </button>

            <img id="modalImage" src="" alt="Food">

            <div class="modal-body">

                <h2 id="modalTitle"></h2>

                <div class="modal-info">
                    <span id="modalRating"></span>
                    <span id="modalCuisine"></span>
                    <span id="modalDifficulty"></span>
                </div>

                <p id="modalDescription"></p>

                <h3>Ingredients</h3>

                <ul id="modalIngredients"></ul>

                <div class="extra-info">

                    <div>
                        <strong>Prep</strong>
                        <span id="modalPrep"></span>
                    </div>

                    <div>
                        <strong>Cook</strong>
                        <span id="modalCook"></span>
                    </div>

                    <div>
                        <strong>Servings</strong>
                        <span id="modalServings"></span>
                    </div>

                    <div>
                        <strong>Calories</strong>
                        <span id="modalCalories"></span>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <script src="script.js"></script>

</body>
</html>

