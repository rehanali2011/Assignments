    right: 15px;
    top: 15px;
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 50%;
    background: white;
    color: #333;
    font-size: 25px;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
}

.close-btn:hover {
    background: #e63946;
    color: white;
}

.modal-body {
    padding: 25px;
}

.modal-body h2 {
    font-size: 28px;
    margin-bottom: 15px;
}

.modal-info {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
