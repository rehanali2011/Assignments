* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #c5d5c5
    /* color: black; */
}
.main heading{
    text-color: black
}



.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}

/* Header */

.header {
    background: #ffffff;
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    z-index: 100;
}

.nav {
    min-height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: #000000;
    white-space: nowrap;
}

.logo span {
    font-size: 28px;
}

/* Search */

.search-box {
    display: flex;
    width: 420px;
}

.search-box input {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid #ddd;
    border-right: none;
    outline: none;
    border-radius: 8px 0 0 8px;
    font-size: 15px;
}

.search-box button {
    padding: 0 20px;
    border: none;
    background: #e63946;
    color: white;
    cursor: pointer;
    border-radius: 0 8px 8px 0;
    font-weight: bold;
}

.search-box button:hover {
    background: #c92f3b;
}

/* Hero */

.hero {
    background: linear-gradient(
        135deg,
        #b60e89
        #000000
    );

    color: rgb(0, 0, 0);
    padding: 70px 0;
    text-align: center;
}

.hero h1 {
    font-size: 42px;
    margin-bottom: 12px;
}

.hero p {
    font-size: 18px;
    opacity: 0.95;
}

/* Menu */

.menu-section {
    padding: 45px 0;
}

.section-heading {
    text-align: center;
    margin-bottom: 30px;
}

.section-heading h2 {
    font-size: 30px;
    margin-bottom: 8px;
}

.section-heading p {
    color: #777;
}

/* Food Grid */

.food-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.food-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
    transition: 0.3s ease;
}

.food-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.13);
}

.food-image {
    width: 100%;
    height: 210px;
    object-fit: cover;
    display: block;
}

.food-body {
    padding: 17px;
}

.food-body h3 {
    font-size: 19px;
    margin-bottom: 10px;
    line-height: 1.3;
}

.food-description {
    color: #777;
    font-size: 14px;
    line-height: 1.5;
    min-height: 63px;
    margin-bottom: 12px;
}

.food-info {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 15px;
}

.info-tag {
    background: #f5f5f5;
    color: #555;
    padding: 6px 9px;
    border-radius: 5px;
    font-size: 12px;
}

.rating {
    color: #e09b00;
}

.details-btn {
    width: 100%;
    padding: 11px;
    background: #e63946;
    border: none;
    color: white;
    border-radius: 7px;
    cursor: pointer;
    font-size: 14px;
    font-weight: bold;
}

.details-btn:hover {
    background: #c92f3b;
}

/* Loader */

.loader {
    text-align: center;
    padding: 50px;
}

.spinner {
    width: 42px;
    height: 42px;
    border: 4px solid #ddd;
    border-top-color: #e63946;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: auto auto 15px;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* Error */

.error-message {
    text-align: center;
    color: #d62828;
    font-weight: bold;
    margin: 20px 0;
}

/* Modal */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: none;
    align-items: center;
    justify-content: center;
