// HIGHER ORDER FUNCTIONS

// 1. Higher Order Function kya hota hai?
// Jo function kisi function ko parameter me le
// ya function return kare, usay Higher Order Function kehte hain.


// 2. Kya map() Higher Order Function hai?

let numbers1 = [1, 2, 3];

let answer1 = numbers1.map(function(num) {
    return num * 2;
});

console.log(answer1);


// 3. Kya forEach() value return karta hai?

let numbers2 = [1, 2, 3];

let answer2 = numbers2.forEach(function(num) {
    console.log(num);
});

console.log(answer2);


// 4. Higher Order Function example

function calculate(a, b, operation) {
    return operation(a, b);
}

let result = calculate(10, 5, function(a, b) {
    return a + b;
});

console.log(result);


// 5. Callback Function kya hota hai?
// Jo function kisi doosre function ko argument ke taur par diya jaye,
// usay Callback Function kehte hain.

function greet(name) {
    console.log("Hello " + name);
}

function userName(callback) {
    callback("Ali");
}

userName(greet);


// 6. Ek function jo doosre function ko parameter me le

function myFunction(callback) {
    callback();
}

myFunction(function() {
    console.log("This is callback function");
});


// 7. filter() kis liye hota hai?
// filter() array me se required elements nikalta hai.


// 8. reduce() ka basic purpose kya hai?
// reduce() array ke elements ko combine karke single value banata hai.


// 9. find() aur filter() me difference
// find() sirf pehla matching element deta hai.
// filter() saare matching elements ka array deta hai.


// 10. map() aur forEach() me difference
// map() new array return karta hai.
// forEach() sirf array ke elements par loop karta hai.



// ==========================================
// MAP()
// ==========================================

// 1. Numbers ko double karo

let nums = [1, 2, 3, 4];

let doubleNumbers = nums.map(function(num) {
    return num * 2;
});

console.log(doubleNumbers);


// 2. Names uppercase

let names = ["Ali", "Ahmed", "Usman", "Rehan"];

let upperNames = names.map(function(name) {
    return name.toUpperCase();
});

console.log(upperNames);


// 3. Prices me 10 add karo

let prices = [50, 100, 150, 200];

let newPrices = prices.map(function(price) {
    return price + 10;
});

console.log(newPrices);


// 4. Students ke names ke sath Mr. add karo

let studentsNames = ["Ali", "Ahmed", "Usman"];

let newStudentsNames = studentsNames.map(function(name) {
    return "Mr. " + name;
});

console.log(newStudentsNames);


// 5. Numbers ko square me convert karo

let numbers3 = [2, 3, 4, 5];

let squareNumbers = numbers3.map(function(num) {
    return num * num;
});

console.log(squareNumbers);



// ==========================================
// FILTER()
// ==========================================

// 1. Even numbers

let numbers4 = [1, 2, 3, 4, 5, 6];

let evenNumbers = numbers4.filter(function(num) {
    return num % 2 === 0;
});

console.log(evenNumbers);


// 2. Names length 5 se zyada

let names2 = ["Ali", "Ahmed", "Usman", "Rehan", "Hamza"];

let longNames = names2.filter(function(name) {
    return name.length > 5;
});

console.log(longNames);


// 3. Prices greater than 100

let prices2 = [50, 120, 80, 200, 150];

let expensivePrices = prices2.filter(function(price) {
    return price > 100;
});

console.log(expensivePrices);


// 4. Passed students

let students = [
    { name: "Ali", marks: 80 },
    { name: "Ahmed", marks: 45 },
    { name: "Usman", marks: 70 },
    { name: "Rehan", marks: 30 }
];

let passedStudents = students.filter(function(student) {
    return student.marks >= 50;
});

console.log(passedStudents);


// 5. Negative numbers filter

let numbers5 = [-5, 2, -3, 4, -1, 6];

let negativeNumbers = numbers5.filter(function(num) {
    return num < 0;
});

console.log(negativeNumbers);



