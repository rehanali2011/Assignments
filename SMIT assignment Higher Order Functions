// ==========================================
// reduce()
// ==========================================

// 1. Sum

let numbers9 = [1, 2, 3, 4];

let sum = numbers9.reduce(function(total, num) {
    return total + num;
}, 0);

console.log(sum);


// 2. Prices total

let prices3 = [100, 200, 300, 400];

let priceTotal = prices3.reduce(function(total, price) {
    return total + price;
}, 0);

console.log(priceTotal);


// 3. Maximum value

let numbers10 = [10, 50, 20, 80, 30];

let maximum = numbers10.reduce(function(max, num) {
    if (num > max) {
        return num;
    }

    return max;
}, numbers10[0]);

console.log(maximum);


// 4. Words ko sentence me convert

let words = ["I", "am", "learning", "JavaScript"];

let sentence = words.reduce(function(result, word) {
    return result + " " + word;
});

console.log(sentence);


// 5. Shopping cart total

let cart = [
    { name: "Shirt", price: 1000 },
    { name: "Shoes", price: 2500 },
    { name: "Cap", price: 500 }
];

let bill = cart.reduce(function(total, item) {
    return total + item.price;
}, 0);

console.log(bill);



