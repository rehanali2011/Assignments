<HTML>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upwork - Find the Right Talent</title>
  <link rel="stylesheet" href="style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

  <header class="header">
    <div class="container nav">
      <a href="#" class="logo">up<span>work</span></a>

      <nav class="desktop-nav">
        <a href="#find-talent">Find Talent</a>
        <a href="#find-work">Find Work</a>
        <a href="#why-upwork">Why Upwork</a>
        <a href="#enterprise">Enterprise</a>
      </nav>

      <div class="nav-actions">
        <button class="login-btn">Log In</button>
        <button class="signup-btn">Sign Up</button>
        <button class="menu-btn" id="menuBtn" aria-label="Open menu">☰</button>
      </div>
    </div>

    <div class="mobile-menu" id="mobileMenu">
      <a href="#find-talent">Find Talent</a>
      <a href="#find-work">Find Work</a>
      <a href="#why-upwork">Why Upwork</a>
      <a href="#enterprise">Enterprise</a>
      <button>Log In</button>
      <button class="mobile-signup">Sign Up</button>
    </div>
  </header>

  <main>
    <section class="hero" id="find-talent">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="eyebrow">THE WORLD'S WORK MARKETPLACE</p>
          <h1>Connect with <span>top talent</span> and get more done.</h1>
          <p class="hero-text">
            Upwork connects businesses with independent professionals from around the world.
            Find the expertise you need to build, grow, and transform your business.
          </p>

          <div class="hero-buttons">
            <a href="#talent" class="primary-btn">Find Talent</a>
            <a href="#find-work" class="secondary-btn">Find Work</a>
          </div>

          <div class="trusted">
            <p>Trusted by leading companies</p>
            <div class="brands">
              <strong>Microsoft</strong>
              <strong>airbnb</strong>
              <strong>Google</strong>
              <strong>Stripe</strong>
            </div>
          </div>
        </div>

        <div class="hero-card">
          <div class="card-top">
            <span class="online-dot"></span>
            <span>Top Rated Talent</span>
          </div>
          <div class="profile">
            <div class="avatar">AS</div>
            <div>
              <h3>Alex Smith</h3>
              <p>Full Stack Developer</p>
            </div>
            <span class="rating">★ 5.0</span>
          </div>
          <div class="skills">
            <span>React</span><span>Node.js</span><span>JavaScript</span>
          </div>
          <div class="profile-bottom">
            <div><small>Hourly rate</small><strong>$45/hr</strong></div>
            <button>Hire Now</button>
          </div>
        </div>
      </div>
    </section>

    <section class="stats">
      <div class="container stats-grid">
        <div><strong>18M+</strong><span>Freelancers</span></div>
        <div><strong>5M+</strong><span>Clients</span></div>
        <div><strong>$4.5B+</strong><span>Paid to freelancers</span></div>
        <div><strong>180+</strong><span>Countries</span></div>
      </div>
    </section>

    <section class="section" id="talent">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">EXPLORE EXPERTISE</p>
          <h2>Find the right talent for your project</h2>
          <p>Access skilled professionals across hundreds of categories.</p>
        </div>

        <div class="category-grid">
          <article class="category">
            <div class="icon">⌘</div>
            <h3>Development & IT</h3>
            <p>Web, mobile, software & more</p><a href="#">Explore →</a>
          </article>
          <article class="category">
            <div class="icon">✦</div>
            <h3>Design & Creative</h3>
            <p>Branding, graphics, UI/UX</p><a href="#">Explore →</a>
          </article>
          <article class="category">
            <div class="icon">◎</div>
            <h3>Sales & Marketing</h3>
            <p>Digital marketing & growth</p><a href="#">Explore →</a>
          </article>
          <article class="category">
            <div class="icon">▤</div>
            <h3>Writing & Translation</h3>
            <p>Content, copy & languages</p><a href="#">Explore →</a>
          </article>
          <article class="category">
            <div class="icon">◴</div>
            <h3>Admin & Support</h3>
            <p>Virtual assistants & support</p><a href="#">Explore →</a>
          </article>
          <article class="category">
            <div class="icon">◫</div>
            <h3>Finance & Accounting</h3>
            <p>Bookkeeping & consulting</p><a href="#">Explore →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="dark-section" id="why-upwork">
      <div class="container feature-grid">
        <div>
          <p class="eyebrow">WHY UPWORK</p>
          <h2>Work with confidence.</h2>
          <p class="feature-intro">Build your team with flexible access to independent talent and tools designed to make
            hiring simple.</p>
          <div class="feature-list">
            <div><b>✓</b><span><strong>Top-quality talent</strong> — Connect with professionals with proven skills and
                experience.</span></div>
            <div><b>✓</b><span><strong>Flexible hiring</strong> — Hire for a project, an ongoing role, or anything in
                between.</span></div>
            <div><b>✓</b><span><strong>Secure payments</strong> — Pay confidently through a protected platform.</span>
            </div>
          </div>
        </div>
        <div class="video-card">
          <div class="play">▶</div>
          <p>Build your team with Upwork</p>
        </div>
      </div>
    </section>

    <section class="section" id="find-work">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">FOR FREELANCERS</p>
          <h2>Turn your skills into opportunities.</h2>
          <p>Find projects that match your expertise and work with clients around the world.</p>
        </div>
        <div class="work-grid">
          <div class="work-card"><span>01</span>
            <h3>Create your profile</h3>
            <p>Showcase your experience, skills, and best work.</p>
          </div>
          <div class="work-card"><span>02</span>
            <h3>Discover projects</h3>
            <p>Search thousands of opportunities that fit your goals.</p>
          </div>
          <div class="work-card"><span>03</span>
            <h3>Get hired</h3>
            <p>Submit proposals and start building lasting client relationships.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta" id="enterprise">
      <div class="container cta-inner">
        <div>
          <p class="eyebrow">GET STARTED TODAY</p>
          <h2>Ready to build something great?</h2>
          <p>Join millions of businesses and professionals working together online.</p>
        </div>
        <a href="#" class="primary-btn light-btn">Get Started</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-grid">
      <div>
        <a href="#" class="logo footer-logo">up<span>work</span></a>
        <p>Where the world does work.</p>
      </div>
      <div>
        <h4>For Clients</h4><a href="#">How to hire</a><a href="#">Talent Marketplace</a><a href="#">Enterprise</a>
      </div>
      <div>
        <h4>For Talent</h4><a href="#">How to find work</a><a href="#">Direct Contracts</a><a href="#">Freelancing
          resources</a>
      </div>
      <div>
        <h4>Resources</h4><a href="#">Help & Support</a><a href="#">Success stories</a><a href="#">Blog</a>
      </div>
    </div>
    <div class="container copyright">
      <span>© 2026 Upwork-style educational project. Not affiliated with Upwork.</span>
      <span>Privacy · Terms · Accessibility</span>
    </div>
  </footer>

  <script src="script.js"></script>
</body>

</html>




<CSS>

*{box-sizing:border-box;margin:0;padding:0}
:root{--green:#14a800;--dark:#181818;--text:#242424;--muted:#666;--light:#f7f7f5;--border:#dedede}
html{scroll-behavior:smooth}
body{font-family:"DM Sans",Arial,sans-serif;color:var(--text);background:#fff;line-height:1.6}
a{text-decoration:none;color:inherit}
button{font:inherit;border:0;cursor:pointer}
.container{width:min(1160px,92%);margin:auto}
.header{background:#fff;border-bottom:1px solid #eee;position:sticky;top:0;z-index:100}
.nav{height:76px;display:flex;align-items:center;gap:38px}
.logo{font-size:30px;font-weight:700;letter-spacing:-1.5px;color:#181818}
.logo span{color:var(--green)}
.desktop-nav{display:flex;gap:28px;font-size:14px;flex:1}
.desktop-nav a:hover{color:var(--green)}
.nav-actions{display:flex;align-items:center;gap:12px}
.login-btn{background:none;padding:10px 12px}
.signup-btn,.primary-btn{background:var(--green);color:#fff;border-radius:7px;padding:12px 22px;font-weight:600;display:inline-block}
.signup-btn:hover,.primary-btn:hover{background:#108a00}
.menu-btn{display:none;background:none;font-size:25px}
.mobile-menu{display:none}

.hero{padding:92px 0 82px;background:linear-gradient(135deg,#f8fbf6 0%,#fff 55%,#f3f8f0 100%);overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1.12fr .88fr;align-items:center;gap:70px}
.eyebrow{font-size:12px;font-weight:700;letter-spacing:1.7px;color:var(--green);margin-bottom:14px}
.hero h1{font-size:clamp(44px,5vw,70px);line-height:1.02;letter-spacing:-3px;max-width:680px}
.hero h1 span{color:var(--green)}
.hero-text{font-size:18px;color:#5e5e5e;max-width:650px;margin:25px 0 32px}
.hero-buttons{display:flex;gap:13px}
.secondary-btn{border:1px solid #222;padding:11px 22px;border-radius:7px;font-weight:600;background:#fff}
.trusted{margin-top:55px}
.trusted p{font-size:12px;color:#777;margin-bottom:13px}
.brands{display:flex;gap:25px;align-items:center;color:#666;font-size:17px;flex-wrap:wrap}
.hero-card{background:#fff;border-radius:18px;padding:27px;box-shadow:0 22px 60px rgba(0,0,0,.12);border:1px solid #eee;transform:rotate(2deg)}
.card-top{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#555;padding-bottom:22px;border-bottom:1px solid #eee}
.online-dot{width:9px;height:9px;background:var(--green);border-radius:50%}
.profile{display:flex;align-items:center;gap:13px;padding:25px 0}
.avatar{width:55px;height:55px;border-radius:50%;background:#dfead9;color:#26751a;display:grid;place-items:center;font-weight:700}
.profile h3{font-size:18px}.profile p{font-size:13px;color:#777}
.rating{margin-left:auto;font-weight:600;font-size:13px}
.skills{display:flex;gap:7px;flex-wrap:wrap}
.skills span{font-size:12px;background:#f1f1ef;padding:7px 10px;border-radius:20px}
.profile-bottom{display:flex;align-items:end;justify-content:space-between;margin-top:27px}
.profile-bottom small{display:block;color:#888;font-size:11px}.profile-bottom strong{font-size:18px}
.profile-bottom button{background:var(--green);color:white;padding:9px 16px;border-radius:6px}

.stats{background:var(--dark);color:white;padding:35px 0}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);text-align:center}
.stats strong{display:block;font-size:29px;color:#fff}.stats span{color:#aaa;font-size:13px}

.section{padding:100px 0}
.section-heading{text-align:center;max-width:720px;margin:0 auto 50px}
.section-heading h2,.feature-grid h2,.cta h2{font-size:clamp(34px,4vw,52px);line-height:1.08;letter-spacing:-1.8px}
.section-heading>p:last-child{color:#6c6c6c;margin-top:13px}
.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}
.category{border:1px solid var(--border);border-radius:12px;padding:27px;transition:.25s}
.category:hover{transform:translateY(-5px);box-shadow:0 14px 35px rgba(0,0,0,.08);border-color:#bbb}
.icon{width:45px;height:45px;border-radius:10px;background:#edf7e9;color:var(--green);display:grid;place-items:center;font-size:23px;margin-bottom:22px}
.category h3{font-size:20px}.category p{font-size:13px;color:#777;margin:7px 0 18px}.category a{font-size:13px;color:var(--green);font-weight:700}

.dark-section{background:#181818;color:#fff;padding:100px 0}
.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.feature-grid h2{max-width:500px}.feature-intro{color:#bbb;max-width:530px;margin:20px 0 35px}
.feature-list{display:grid;gap:22px}.feature-list div{display:flex;gap:15px;color:#bbb}.feature-list b{color:#76d65e}.feature-list strong{color:#fff}
.video-card{min-height:390px;border-radius:18px;background:linear-gradient(145deg,#31462e,#182318);display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}
.play{width:74px;height:74px;border-radius:50%;background:#fff;color:#181818;display:grid;place-items:center;font-size:24px;padding-left:4px;margin-bottom:18px}.video-card p{font-size:15px;color:#ddd}

.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.work-card{background:#f7f7f5;border-radius:14px;padding:35px}.work-card span{color:var(--green);font-weight:700;font-size:13px}.work-card h3{font-size:22px;margin:25px 0 10px}.work-card p{color:#666;font-size:14px}

.cta{background:var(--green);color:#fff;padding:75px 0}.cta .eyebrow{color:#d9ffd2}.cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.cta h2{max-width:700px}.cta p:last-child{margin-top:10px;color:#e6ffe2}.light-btn{background:#fff;color:#181818}.light-btn:hover{background:#f2f2f2}

.footer{background:#181818;color:#fff;padding:65px 0 25px}.footer-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:40px;padding-bottom:55px}.footer-logo{color:#fff}.footer-grid>div>p{color:#aaa;margin-top:12px;font-size:14px}.footer h4{font-size:14px;margin-bottom:16px}.footer-grid a:not(.logo){display:block;color:#aaa;font-size:13px;margin:9px 0}.footer-grid a:not(.logo):hover{color:#fff}.copyright{border-top:1px solid #333;padding-top:22px;display:flex;justify-content:space-between;color:#777;font-size:11px}

@media(max-width:850px){
 .desktop-nav{display:none}.menu-btn{display:block}.nav{justify-content:space-between}.mobile-menu{padding:15px 4%;background:#fff;border-top:1px solid #eee}.mobile-menu.active{display:grid;gap:4px}.mobile-menu a,.mobile-menu button{text-align:left;padding:13px;background:none;border-radius:5px}.mobile-menu a:hover,.mobile-menu button:hover{background:#f4f4f4}.mobile-signup{color:#fff!important;background:var(--green)!important;text-align:center!important}
 .hero{padding:65px 0}.hero-grid{grid-template-columns:1fr;gap:50px}.hero-card{max-width:560px;width:100%;margin:auto}.stats-grid{grid-template-columns:repeat(2,1fr);gap:25px}
 .category-grid{grid-template-columns:repeat(2,1fr)}.feature-grid{grid-template-columns:1fr}.video-card{min-height:300px}.work-grid{grid-template-columns:1fr}.cta-inner{align-items:flex-start;flex-direction:column}.footer-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:560px){
 .nav{height:68px}.logo{font-size:26px}.login-btn,.signup-btn{display:none}.hero h1{font-size:45px;letter-spacing:-2px}.hero-text{font-size:16px}.hero-buttons{flex-direction:column}.hero-buttons a{text-align:center}.brands{gap:15px;font-size:14px}.hero-card{padding:20px;transform:none}.profile-bottom{align-items:center}.stats-grid{grid-template-columns:1fr 1fr}.stats strong{font-size:23px}.section,.dark-section{padding:70px 0}.category-grid{grid-template-columns:1fr}.section-heading{margin-bottom:35px}.section-heading h2,.feature-grid h2,.cta h2{font-size:36px}.footer-grid{grid-template-columns:1fr}.copyright{flex-direction:column;gap:8px}
}


<JAVASCRIPT>

const menuBtn = document.getElementById("menuBtn");
const mobileMenu = document.getElementById("mobileMenu");

menuBtn.addEventListener("click", () => {
  mobileMenu.classList.toggle("active");
  menuBtn.textContent = mobileMenu.classList.contains("active") ? "✕" : "☰";
});

document.querySelectorAll(".mobile-menu a").forEach(link => {
  link.addEventListener("click", () => {
    mobileMenu.classList.remove("active");
    menuBtn.textContent = "☰";
  });
});

document.querySelectorAll("a[href='#']").forEach(link => {
  link.addEventListener("click", e => e.preventDefault());
});
