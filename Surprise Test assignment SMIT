        padding: 15px 4%;
    }

    .logo {
        font-size: 22px;
    }

    .modal-content {
        padding: 25px 20px;
    }

    .modal-title {
        font-size: 23px;
    }
}


====> JAVA SCRIPT

const postsContainer = document.getElementById("postsContainer");

const loading = document.getElementById("loading");

const errorMessage = document.getElementById("errorMessage");

const noResults = document.getElementById("noResults");

const searchInput = document.getElementById("searchInput");

const searchBtn = document.getElementById("searchBtn");

const postModal = document.getElementById("postModal");

const closeModal = document.getElementById("closeModal");

const modalContent = document.getElementById("modalContent");


// API URLs

const ALL_POSTS_API = "https://dummyjson.com/posts";

const SEARCH_API = "https://dummyjson.com/posts/search?q=";

const SINGLE_POST_API = "https://dummyjson.com/posts/";


// ================================
// LOAD ALL POSTS
// ================================

async function loadPosts() {

    showLoading();

    clearError();

    try {

        const response = await fetch(ALL_POSTS_API);

        if (!response.ok) {
            throw new Error("Failed to load posts.");
        }

        const data = await response.json();

        displayPosts(data.posts);

    } catch (error) {

        showError(
            "Unable to load posts. Please check your internet connection and try again."
        );

    } finally {

        hideLoading();

    }
}


// ================================
// DISPLAY POSTS
// ================================

function displayPosts(posts) {

    postsContainer.innerHTML = "";

    noResults.style.display = "none";


    if (!posts || posts.length === 0) {

        noResults.style.display = "block";

        return;
    }


    posts.forEach(post => {

        const card = document.createElement("div");

        card.className = "post-card";


        card.innerHTML = `

            <span class="post-number">
                Post #${post.id}
            </span>

            <h2 class="post-title">
                ${escapeHTML(post.title)}
            </h2>

            <p class="post-body">
                ${escapeHTML(post.body)}
            </p>

            <div class="post-info">

                <span>
                    👍 ${post.reactions?.likes || 0}
                </span>

                <span>
                    👎 ${post.reactions?.dislikes || 0}
                </span>

                <span>
                    👁 ${post.views || 0}
                </span>

            </div>

            <button
                class="read-more"
                onclick="openPost(${post.id})"
            >
                Read More
            </button>

        `;


        postsContainer.appendChild(card);

    });
}


// ================================
// LOAD SINGLE POST
// ================================

async function openPost(id) {

    modalContent.innerHTML = `
        <p class="loading">Loading post...</p>
    `;

    postModal.classList.add("active");


    try {

        const response = await fetch(
            SINGLE_POST_API + id
        );


        if (!response.ok) {
            throw new Error("Post not found.");
        }


        const post = await response.json();


        modalContent.innerHTML = `

            <h2 class="modal-title">
                ${escapeHTML(post.title)}
            </h2>


            <p class="modal-body">
                ${escapeHTML(post.body)}
            </p>


            <div class="modal-info">

                <div class="info-box">
                    🆔 Post ID: ${post.id}
                </div>

                <div class="info-box">
                    👁 Views: ${post.views || 0}
                </div>

                <div class="info-box">
                    👍 Likes: ${post.reactions?.likes || 0}
                </div>

                <div class="info-box">
                    👎 Dislikes: ${post.reactions?.dislikes || 0}
                </div>

                <div class="info-box">
                    👤 User ID: ${post.userId}
                </div>

            </div>


            <h3>Tags</h3>

            <div class="tags">

                ${post.tags && post.tags.length > 0
                ? post.tags.map(tag => `
                        <span class="tag">
                            #${escapeHTML(tag)}
                        </span>
                    `).join("")
                : "<span>No tags</span>"
            }

            </div>

        `;


    } catch (error) {

        modalContent.innerHTML = `
            <p class="error-message" style="display:block;">
                Unable to load this post.
            </p>
        `;

    }

}


// ================================
// SEARCH POSTS
// ================================

async function searchPosts() {

    const searchText = searchInput.value.trim();


    // Empty search = load all posts

    if (searchText === "") {

        loadPosts();

        return;
    }


    showLoading();

    clearError();


    try {

        const response = await fetch(
            SEARCH_API + encodeURIComponent(searchText)
        );


        if (!response.ok) {
            throw new Error("Search failed.");
        }


        const data = await response.json();


        displayPosts(data.posts);


    } catch (error) {

        showError(
            "Search failed. Please try again."
        );

    } finally {

        hideLoading();

    }

}


// ================================
// SEARCH BUTTON
// ================================

searchBtn.addEventListener(
    "click",
    searchPosts
);


// ================================
// SEARCH USING ENTER
// ================================

searchInput.addEventListener(
    "keydown",
    function (event) {

        if (event.key === "Enter") {

            searchPosts();

        }

    }
);


// ================================
// CLOSE MODAL
// ================================

closeModal.addEventListener(
    "click",
    function () {

        postModal.classList.remove("active");

    }
);


// ================================
// CLOSE MODAL OUTSIDE
// ================================

postModal.addEventListener(
    "click",
    function (event) {

        if (event.target === postModal) {

            postModal.classList.remove("active");

        }

    }
);


// ================================
// LOADING FUNCTIONS
// ================================

function showLoading() {

    loading.style.display = "block";

}

function hideLoading() {

    loading.style.display = "none";

}


// ================================
// ERROR FUNCTIONS
// ================================

function showError(message) {

    errorMessage.textContent = message;

    errorMessage.style.display = "block";

}

function clearError() {

    errorMessage.textContent = "";

    errorMessage.style.display = "none";

}


// ================================
// HTML SECURITY
// ================================

function escapeHTML(text) {

    const div = document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


// ================================
// START APPLICATION
// ================================

loadPosts();
