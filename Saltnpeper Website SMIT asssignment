}

.navbar {
    min-height: 82px
}

.navbar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff
}

.logo-mark {
    width: 48px;
    height: 48px;
    border: 2px solid #fff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: Georgia;
    font-size: 29px
}

.brand-text {
    font-family: Georgia, serif;
    font-size: 14px;
