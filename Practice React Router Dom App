  }

  .products-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
  }

  .dashboard-header h1 {
    font-size: 32px;
  }

  .detail-content {
    padding: 25px;
  }

  .detail-content h1 {
    font-size: 32px;
  }

  .detail-info {
    grid-template-columns: 1fr;
  }

  .about-content h1 {
    font-size: 40px;
  }

  .about-features {
    grid-template-columns: 1fr;
  }

}


