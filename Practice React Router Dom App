.tags span {
  background: #e0f2fe;
  color: #0369a1;
  padding: 6px 12px;
  border-radius: 15px;
  font-size: 12px;
}

.detail-message {
  padding: 80px;
  text-align: center;
}


/* =========================
   ABOUT
========================= */

.about-page {
  min-height: calc(100vh - 70px);
  background: #0f172a;
  color: white;
  padding: 100px 10%;
}

.about-content {
