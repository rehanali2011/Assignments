/* =========================
   PRODUCT DETAIL
========================= */

.detail-page {
  background: #f1f5f9;
  min-height: calc(100vh - 70px);
  padding: 45px 7%;
}

.back-btn {
  display: inline-block;
  color: #0f172a;
  text-decoration: none;
  margin-bottom: 25px;
  font-weight: bold;
}

.detail-container {
  max-width: 1100px;
  margin: auto;
  background: white;
  display: grid;
  grid-template-columns: 45% 55%;
  border-radius: 12px;
  overflow: hidden;
}

.detail-image {
  background: #e2e8f0;
  min-height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.detail-image img {
  width: 100%;
  max-height: 500px;
  object-fit: contain;
}

.detail-content {
  padding: 45px;
}

.detail-category {
  color: #0284c7;
  text-transform: uppercase;
  font-size: 13px;
  font-weight: bold;
}

.detail-content h1 {
  font-size: 42px;
  margin: 12px 0;
}

.detail-description {
  color: #64748b;
  line-height: 1.7;
}

.detail-price {
  font-size: 34px;
  font-weight: bold;
  margin: 25px 0;
}

.detail-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  border-top: 1px solid #e2e8f0;
  padding-top: 20px;
}

.detail-info div {
  display: flex;
