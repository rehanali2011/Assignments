===> PRODUCT.HTML

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Product Details</title>

    <link
        rel="stylesheet"
        href="style.css"
    >

</head>


<body>

    <!-- Navbar -->

    <nav class="navbar">

        <div class="logo">
            Shop<span>Explorer</span>
        </div>

        <a
            href="index.html"
            class="back-btn"
        >
            ← Back to Products
        </a>

    </nav>


    <!-- Loading -->

    <div
        id="loading"
        class="loading"
    >
        Loading product...
    </div>


    <!-- Error -->

    <div
        id="errorMessage"
        class="error-message"
    ></div>


    <!-- Product Details -->

    <main
        id="detailContainer"
        class="detail-container"
        style="display: none;"
    >

        <a
            href="index.html"
            class="back-btn"
        >
            ← Back to Products
        </a>


        <div
            id="productDetail"
            class="detail-grid"
        ></div>

    </main>


    <script>

        const API =
            "https://dummyjson.com/products/";

        const loading =
            document.getElementById("loading");

        const errorMessage =
            document.getElementById("errorMessage");

        const detailContainer =
            document.getElementById("detailContainer");

        const productDetail =
            document.getElementById("productDetail");


        /*
            URL QUERY PRACTICE

            Example:

            product.html?id=2

            URLSearchParams gets
            the id from URL.
        */

        const params =
            new URLSearchParams(
                window.location.search
            );


        const productId =
            params.get("id");


        async function loadProduct() {

            if (!productId) {

                showError(
                    "Product ID nahi mila."
                );

                return;

            }


            try {

                /*
                    SINGLE PRODUCT API

                    /products/2
                */

                const response =
                    await fetch(
                        API + productId
                    );


                if (!response.ok) {

                    throw new Error(
                        "Product not found"
                    );

                }


                const product =
                    await response.json();


                showProduct(product);


            } catch (error) {

                showError(
                    "Product details load nahi ho sakin."
                );

            } finally {

                loading.style.display =
                    "none";

            }

        }


        function showProduct(product) {

            detailContainer.style.display =
                "block";


            productDetail.innerHTML = `

                <div class="detail-image">

                    <img
                        src="${product.images[0]}"
                        alt="${escapeHTML(product.title)}"
                    >

                </div>


                <div>

                    <p class="detail-category">
                        ${escapeHTML(product.category)}
                    </p>


                    <h1 class="detail-title">
                        ${escapeHTML(product.title)}
                    </h1>


                    <p class="detail-description">
                        ${escapeHTML(product.description)}
                    </p>


                    <div class="detail-price">
                        $${product.price}
                    </div>


                    <div class="detail-info">

                        <div class="detail-box">
                            ⭐ Rating:
                            ${product.rating}
                        </div>


                        <div class="detail-box">
                            📦 Stock:
                            ${product.stock}
                        </div>


                        <div class="detail-box">
                            🏷 Brand:
                            ${escapeHTML(
                                product.brand || "N/A"
                            )}
                        </div>


                        <div class="detail-box">
                            📊 Discount:
                            ${product.discountPercentage}%
                        </div>


                        <div class="detail-box">
                            📏 Weight:
                            ${product.weight}
                        </div>


                        <div class="detail-box">
                            🆔 Product ID:
                            ${product.id}
                        </div>

                    </div>


                    <div class="tags">

                        ${
                            product.tags
                            ? product.tags.map(tag => `
                                <span class="tag">
                                    #${escapeHTML(tag)}
                                </span>
                            `).join("")
                            : ""
                        }

                    </div>

                </div>

            `;

        }


        function showError(message) {

            errorMessage.textContent =
                message;

            errorMessage.style.display =
                "block";

        }


        function escapeHTML(text) {

            const div =
                document.createElement("div");

            div.textContent =
                text;

            return div.innerHTML;

        }


        loadProduct();

    </script>

</body>

</html>



