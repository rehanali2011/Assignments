// 1. Maximum Number Logic
function findMaximum() {
  const a = Number(document.getElementById('max1').value);
  const b = Number(document.getElementById('max2').value);
  const c = Number(document.getElementById('max3').value);
  if ([a, b, c].some(Number.isNaN)) { document.getElementById('maxResult').textContent = 'Please enter all three numbers.'; return; }
  let max = a;
  if (b > max) max = b;
  if (c > max) max = c;
  document.getElementById('maxResult').textContent = 'Maximum number is: ' + max;
}

// 2. Minimum Number Logic
function findMinimum() {
  const a = Number(document.getElementById('min1').value);
  const b = Number(document.getElementById('min2').value);
  const c = Number(document.getElementById('min3').value);
  if ([a, b, c].some(Number.isNaN)) { document.getElementById('minResult').textContent = 'Please enter all three numbers.'; return; }
  let min = a;
  if (b < min) min = b;
  if (c < min) min = c;
  document.getElementById('minResult').textContent = 'Minimum number is: ' + min;
}

// 3. Random Password Generate
const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+';
function generatePassword() {
  const length = Number(document.getElementById('passwordLength').value);
  let password = '';
  for (let i = 0; i < length; i++) {
    const randomIndex = Math.floor(Math.random() * characters.length);
    password += characters[randomIndex];
  }
  document.getElementById('password').value = password;
  document.getElementById('passwordResult').textContent = 'Password generated successfully.';
}
function updateLength() {
  document.getElementById('lengthValue').textContent = document.getElementById('passwordLength').value;
}
function copyPassword() {
  const password = document.getElementById('password').value;
  if (!password) { document.getElementById('passwordResult').textContent = 'Generate a password first.'; return; }
  navigator.clipboard.writeText(password).then(() => {
    document.getElementById('passwordResult').textContent = 'Password copied to clipboard.';
  });
}

// 4. Ramadan Logic
function checkRamadan() {
  const input = document.getElementById('ramadanDate').value;
  const result = document.getElementById('ramadanResult');
  if (!input) { result.textContent = 'Please select a date.'; return; }
  const selected = new Date(input + 'T00:00:00');
  const start = new Date('2026-02-18T00:00:00');
  const end = new Date('2026-03-19T00:00:00');
  if (selected >= start && selected <= end) {
    result.textContent = 'Yes — this date is within the Ramadan 2026 demo period.';
  } else {
    result.textContent = 'No — this date is outside the Ramadan 2026 demo period.';
  }
}
