        <section class="card">
            <div class="number">02</div>
            <h2>Minimum Number</h2>
            <p>Enter three numbers and find the smallest number.</p>
            <div class="inputs"><input id="min1" type="number" placeholder="Number 1"><input id="min2" type="number"
                    placeholder="Number 2"><input id="min3" type="number" placeholder="Number 3"></div>
            <button onclick="findMinimum()">Find Minimum</button>
            <div class="result" id="minResult">Result will appear here.</div>
        </section>

        <section class="card">
            <div class="number">03</div>
            <h2>Random Password</h2>
            <p>Generate a random password using letters, numbers and symbols.</p>
            <div class="password-row"><input id="password" readonly placeholder="Your password"><button class="copy"
                    onclick="copyPassword()">Copy</button></div>
            <label class="range-label">Password Length: <strong id="lengthValue">12</strong></label>
            <input class="range" id="passwordLength" type="range" min="6" max="30" value="12" oninput="updateLength()">
