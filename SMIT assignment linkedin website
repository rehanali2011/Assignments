    display: block;
    padding: 7px;
    color: #555;
    font-size: 12px
}

.shortcuts a:hover {
    color: var(--blue)
}

.composer {
    padding: 15px
}

.compose-top {
    display: flex;
    gap: 10px
}

.compose-top button {
    flex: 1;
    border: 1px solid #777;
    background: white;
    border-radius: 25px;
    text-align: left;
    padding: 10px 18px;
    color: #666
}

.compose-actions {
    display: flex;
    justify-content: space-around;
    margin-top: 13px
}

.compose-actions button,
.post-actions button {
    border: 0;
    background: none;
    color: #555;
    padding: 8px
}

.sort-row {
    font-size: 11px;
    color: #777;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin: 10px 0
}

.sort-row button {
    border: 0;
    background: none;
    font-weight: 700
}

.post {
    padding: 15px;
    margin-bottom: 12px
}

.post-head {
    display: flex;
    gap: 10px;
    align-items: center
}

.post-head h3 {
    font-size: 14px;
    margin: 0
}

.post-head p {
    font-size: 11px;
    color: #777;
    margin: 0
}

.more {
    margin-left: auto;
    border: 0;
    background: none
}

.post-text {
    font-size: 13px;
    margin: 15px 0
}

.post-image {
    height: 240px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    padding: 30px;
    font-size: 28px
}

.design-img {
    background: linear-gradient(135deg, #17212b, #2676bb);
    color: #fff
}

.code-preview {
    background: #1e1e1e;
    color: #d4d4d4;
    border-radius: 5px;
    padding: 28px;
    font-family: monospace;
    line-height: 2
}

.code-preview span {
    color: #569cd6
}

.code-preview b {
    color: #4ec9b0
}

.engagement {
    display: flex;
    justify-content: space-between;
    color: #777;
    font-size: 11px;
    padding: 8px 2px
}

.post-actions {
    border-top: 1px solid #eee;
    display: flex;
    justify-content: space-around;
    padding-top: 4px
}

.post-actions button:hover {
    background: #eee;
    border-radius: 4px
}

.news,
.suggestions {
    padding: 18px
}

.news h2,
.suggestions h2 {
    font-size: 17px;
    margin: 0
}

.muted {
    font-size: 11px;
    color: #777
}

.news a {
    display: block;
    color: #222;
    font-size: 12px;
    padding: 11px 0
}

.news a:hover {
    color: var(--blue)
}

.news small {
    display: block;
    color: #777;
    font-size: 10px
}

.suggest {
    display: flex;
    gap: 10px;
    margin-top: 18px
}

.suggest p {
    font-size: 10px;
    color: #777;
    margin: 0
}

.suggest button {
    border: 1px solid var(--blue);
    background: #fff;
    color: var(--blue);
    border-radius: 20px;
    padding: 4px 10px;
    margin-top: 6px;
    font-weight: 600;
    font-size: 11px
}

.orange {
    background: #f4dfd0;
    color: #9b4d18
}

.purple {
    background: #e3dcf4;
    color: #6448a5
}

.green {
    background: #dcebdc;
    color: #31703b
}

.profile-layout {
    width: min(1120px, 94%);
    margin: 24px auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 20px
}

.profile-header {
    position: relative
}

.profile-cover {
    height: 190px;
    background: linear-gradient(120deg, #4c7896, #b8d5e7)
}

.profile-avatar {
    position: absolute;
    top: 135px;
    left: 25px;
    width: 120px;
    height: 120px;
    font-size: 28px;
    border: 4px solid white
}

.profile-info {
    padding: 75px 28px 25px
}

.profile-title {
    display: flex;
    justify-content: space-between
}

.profile-title h1 {
    font-size: 27px;
    margin: 0
}

.profile-title p {
    margin: 4px 0;
    font-size: 14px
}

.edit-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #777;
    background: #fff
}

.bio {
    max-width: 760px;
    font-size: 13px;
    margin: 20px 0
}

.profile-buttons {
    display: flex;
    gap: 9px;
    flex-wrap: wrap
}

.outline {
    background: #fff;
    border: 1px solid var(--blue);
    color: var(--blue)
}

.content-panel {
    padding: 24px;
    margin-top: 15px
}

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center
}

.section-title h2 {
    font-size: 21px;
    margin: 0
}

.section-title button {
    border: 0;
    background: none;
    font-size: 19px
}

.experience {
    display: flex;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid #eee
}

.experience:last-child {
    border-bottom: 0
}

.company-logo {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    background: #e7f0f8;
    color: var(--blue);
    font-size: 23px;
    font-weight: 700;
    flex: none
}

.company-logo.dark {
    background: #222;
    color: #fff
}

.experience h3 {
    margin: 0;
    font-size: 16px
}

.experience p,
.experience span {
    font-size: 12px;
    margin: 2px 0;
    color: #555
}

.experience span {
    color: #777
}

.exp-text {
    margin-top: 12px !important
}

.skills-list {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 18px
}

.skills-list span {
    border: 1px solid #aaa;
    border-radius: 20px;
    padding: 7px 14px;
    font-size: 12px
}

.side-card {
    padding: 18px;
    margin-bottom: 15px
}

.side-card h3 {
    font-size: 14px
}

.side-card p {
    font-size: 12px
}

.person {
    display: flex;
    gap: 10px;
    margin-top: 17px
}

.person p {
    margin: 0;
    color: #777
}

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: #0008;
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 20px
}

.modal.show {
    display: flex
}

.modal-card {
    width: min(520px, 100%);
    background: #fff;
    border-radius: 9px;
    padding: 25px;
    position: relative
}

.modal-card h2 {
    margin-top: 0
}

.modal-card textarea {
    min-height: 130px;
    resize: vertical
}

.close {
    position: absolute;
    right: 15px;
    top: 10px;
    border: 0;
    background: none;
    font-size: 28px
}

.modal-footer {
    text-align: right;
    margin-top: 15px
}

@media(max-width:950px) {
    .feed-layout {
        grid-template-columns: 200px minmax(0, 1fr)
    }

    .right-col {
        display: none
    }

    .search {
        width: 220px
    }

    .profile-layout {
        grid-template-columns: 1fr
    }

    .profile-side {
        display: none
    }

    .nav-item {
        min-width: 58px
    }
}

@media(max-width:700px) {
    .topbar {
        height: 58px
    }

    .topbar-inner {
        width: 92%
    }

    .search {
        width: auto;
        flex: 1
    }

    .main-nav {
        display: none
    }

    .mobile-menu-btn {
        display: block
    }

    .mobile-nav.show {
        display: grid;
        background: #fff;
        border-bottom: 1px solid #ddd;
        position: fixed;
        top: 58px;
        left: 0;
        right: 0;
        z-index: 19;
        box-shadow: 0 5px 15px #0002
    }

    .mobile-nav a {
        padding: 14px 5%;
        color: #444;
        border-bottom: 1px solid #eee
    }

    .feed-layout {
        display: block;
        margin-top: 15px
    }

    .left-col {
        display: none
    }

    .profile-layout {
        width: 96%;
        margin: 12px auto
    }

    .profile-cover {
        height: 130px
    }

    .profile-avatar {
        top: 82px;
        width: 95px;
        height: 95px
    }

    .profile-info {
        padding: 60px 18px 20px
    }

    .profile-title {
        gap: 15px
    }

    .profile-title h1 {
        font-size: 23px
    }

    .profile-buttons .btn {
        padding: 9px 15px
    }

    .auth-main {
        padding: 25px 12px
    }

    .auth-card {
        padding: 25px;
        width: 100%;
        max-width: 410px
    }

    .brand {
        font-size: 31px
    }

    .compose-actions button {
        font-size: 11px
    }

    .post-image {
        height: 190px
    }

    .design-img {
        font-size: 23px
    }
}

@media(max-width:420px) {
    .app-brand {
        font-size: 26px
    }

    .search {
        max-width: 150px
    }

    .post-actions button {
        font-size: 11px;
        padding: 8px 3px
    }

    .profile-title {
        flex-direction: column
    }

    .profile-title .edit-btn {
        position: absolute;
        right: 18px;
        top: 185px
    }

    .profile-buttons {
        display: grid
    }

    .profile-buttons .btn {
        width: 100%
    }
}

